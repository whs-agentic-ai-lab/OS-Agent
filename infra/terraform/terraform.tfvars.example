# 이 파일을 복사해서 terraform.tfvars로 만들고 값을 채우세요.
# terraform.tfvars는 .gitignore에 들어있어서 git에 올라가지 않습니다.

aws_region         = "us-east-1"
availability_zone  = "us-east-1a"
instance_type      = "t3.small"

# 팀 공용 AWS 계정에 등록해둔 CLI 프로필 이름. 비워두면 기본 프로필을 씀.
# 설정 전에 터미널에서: aws configure --profile <프로필 이름>  (팀 공용 계정 Access Key 입력)
aws_profile        = ""

budget_alert_email             = "your-email@example.com"
attach_cloudwatch_agent_policy = false
create_golden_ami              = false
