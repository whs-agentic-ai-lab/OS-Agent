# 이 파일을 terraform.tfvars로 복사한 뒤 현재 실험에서 검증한 값만 채우세요.
# terraform.tfvars는 Git에 커밋하지 않습니다.

aws_profile    = ""
project_name   = "os-agent"
environment_id = "trial-0826"
confirm_new_state = true

# Canonical Ubuntu 24.04 amd64 AMI를 한 번 확인한 뒤 정확한 ID로 고정합니다.
base_ami_id = "ami-xxxxxxxxxxxxxxxxx"

# 모두 ECR image manifest digest입니다. tag가 아닙니다.
runtime_image_digest    = "sha256:REPLACE_WITH_64_HEX"
container1_image_digest = "sha256:REPLACE_WITH_64_HEX"
target_image_digest     = "sha256:REPLACE_WITH_64_HEX"

# 공식 Vector 0.57.0 x86_64 GNU archive SHA-256입니다.
vector_archive_sha256 = "REPLACE_WITH_64_HEX"

# FastAPI Evidence API가 구현되기 전에는 false로 둡니다.
enable_remote_evidence_sink = false
evidence_api_url             = ""
collector_token_parameter_name = ""
# customer-managed KMS key를 쓰는 SecureString일 때만 채웁니다.
collector_token_kms_key_arn = ""
